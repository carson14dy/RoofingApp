  "D108 (B6 stage S1): the layer popover becomes the options sheet (DESIGN 13.6)",
  "",
  "  <section class=\"sheet map-options\" id=\"map-options\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"mo-title\" hidden>\n    <header class=\"mo-head\">\n      <svg class=\"mo-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path class=\"fill\" d=\"M12 3.2 21.4 8.4 12 13.6 2.6 8.4Z\"/><path class=\"fill\" d=\"M4.6 11.6 12 15.7l7.4-4.1 2 1.1-9.4 5.2-9.4-5.2Z\"/></svg>\n      <h2 class=\"mo-title\" id=\"mo-title\" tabindex=\"-1\">Map options</h2>\n      <button type=\"button\" class=\"mo-close\" id=\"mo-close\" aria-label=\"Close map options\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n      </button>\n    </header>\n    <div class=\"mo-body\" id=\"mo-body\">\n      <section class=\"mo-group\" aria-labelledby=\"mo-base-h\">\n        <h3 class=\"mo-h\" id=\"mo-base-h\">Base map</h3>\n        <div class=\"mo-cards\" role=\"group\" aria-labelledby=\"mo-base-h\">\n          <button type=\"button\" class=\"mo-card\" data-group=\"base\" data-key=\"map\" aria-pressed=\"true\"><span class=\"mo-label\">Map</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-card\" data-group=\"base\" data-key=\"imagery\" aria-pressed=\"false\" data-legend=\"Imagery: USDA, USGS, The National Map. Your IP address and the map area you view go to USGS while it is on.\"><span class=\"mo-label\">Imagery</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n        </div>\n        <p class=\"mo-line\" id=\"mo-base-line\" hidden></p>\n      </section>\n\n      <section class=\"mo-group\" aria-labelledby=\"mo-live-h\">\n        <h3 class=\"mo-h\" id=\"mo-live-h\">Live weather</h3>\n        <div class=\"mo-chips\" role=\"group\" aria-labelledby=\"mo-live-h\">\n          <button type=\"button\" class=\"mo-chip\" data-group=\"live\" data-key=\"precip\" aria-pressed=\"true\" data-legend=\"Rate as liquid water. Radar estimate up to now, High-Resolution Rapid Refresh (HRRR) model forecast after.\"><span class=\"mo-label\">Precipitation</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"live\" data-key=\"temp\" aria-pressed=\"false\" data-legend=\"HRRR model temperature, in °F. Town numbers are the National Weather Service (NWS) forecast.\"><span class=\"mo-label\">Temperature</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"live\" data-key=\"wind\" aria-pressed=\"false\" data-legend=\"HRRR model. Roofing limit 25 mph.\"><span class=\"mo-label\">Wind gusts</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n        </div>\n        <p class=\"mo-line\" id=\"mo-live-line\" hidden></p>\n      </section>\n\n      <section class=\"mo-group\" aria-labelledby=\"mo-hist-h\">\n        <h3 class=\"mo-h\" id=\"mo-hist-h\">Five-year history</h3>\n        <p class=\"mo-sub\">Past records from the last five years. Not a forecast.</p>\n        <div class=\"mo-chips\" role=\"group\" aria-labelledby=\"mo-hist-h\">\n          <button type=\"button\" class=\"mo-chip\" data-group=\"history\" data-key=\"hail\" aria-pressed=\"false\"><span class=\"mo-label\">Hail</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"history\" data-key=\"heat\" aria-pressed=\"false\"><span class=\"mo-label\">Heat</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"history\" data-key=\"wind\" aria-pressed=\"false\"><span class=\"mo-label\">Wind</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"history\" data-key=\"flood\" aria-pressed=\"false\"><span class=\"mo-label\">Flood</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"history\" data-key=\"fire_smoke\" aria-pressed=\"false\" data-reason=\"Coming later: fire is not in the map yet. Coming later: smoke is not in the map yet.\"><span class=\"mo-label\">Fire and smoke</span><span class=\"mo-note\">Coming</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n        </div>\n        <p class=\"mo-line\" id=\"mo-hist-line\" hidden></p>\n        <p class=\"mo-line\" id=\"mo-hist-reason\" hidden></p>\n      </section>\n\n      <section class=\"mo-group\" aria-labelledby=\"mo-land-h\">\n        <h3 class=\"mo-h\" id=\"mo-land-h\">Landmarks</h3>\n        <p class=\"mo-sub\">Schools, parks, hospitals, airports, and fire and EMS stations, from the public lists named under About.</p>\n        <div class=\"mo-chips\" role=\"group\" aria-labelledby=\"mo-land-h\">\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"s\" aria-pressed=\"false\" data-name=\"schools\"><span class=\"mo-label\">Schools</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"p\" aria-pressed=\"false\" data-name=\"parks\"><span class=\"mo-label\">Parks</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"h\" aria-pressed=\"false\" data-name=\"hospitals\"><span class=\"mo-label\">Hospitals</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"a\" aria-pressed=\"false\" data-name=\"airports\"><span class=\"mo-label\">Airports</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"f\" aria-pressed=\"false\" data-name=\"fire and EMS stations\"><span class=\"mo-label\">Fire and EMS stations</span><span class=\"mo-note\">Data unavailable</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n          <button type=\"button\" class=\"mo-chip\" data-group=\"landmark\" data-key=\"c\" aria-pressed=\"false\" data-reason=\"Places of worship are not shown yet: the use terms of the list they come from are still being read, so no church is drawn or named.\"><span class=\"mo-label\">Churches</span><span class=\"mo-note\">Held</span><svg class=\"mo-tick\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg></button>\n        </div>\n        <p class=\"mo-line\" id=\"mo-land-line\" data-template=\"{kinds} from the public lists named under About, shown as dots with their names.\" hidden></p>\n        <p class=\"mo-line\" id=\"mo-land-reason\" data-waiting=\"Turn on Points of interest to show these.\" hidden></p>\n      </section>\n\n      <div class=\"mo-group mo-switches\">\n        <div class=\"mo-switch\">\n          <label class=\"mo-switch-row\">\n            <span class=\"mo-switch-text\"><span class=\"mo-switch-name\">Points of interest</span><span class=\"mo-desc\">Landmark dots and names, for the kinds chosen above</span></span>\n            <input type=\"checkbox\" role=\"switch\" id=\"tg-poi\" checked>\n          </label>\n        </div>\n        <div class=\"mo-switch\">\n          <label class=\"mo-switch-row\">\n            <span class=\"mo-switch-text\"><span class=\"mo-switch-name\">Highlight recent radar hail</span><span class=\"mo-desc\">Radar estimate of 1 in or more, last 30 days</span></span>\n            <input type=\"checkbox\" role=\"switch\" id=\"tg-hail-recent\" data-legend=\"Buildings in cells where radar estimated 1 in or more in the last 30 days are highlighted. Buildings in other cells are not; that is not the same as no hail. Radar estimate, not a measurement at the ground.\">\n          </label>\n          <p class=\"mo-line\" id=\"mo-recent-line\" hidden></p>\n        </div>\n        <div class=\"mo-switch\">\n          <label class=\"mo-switch-row\">\n            <span class=\"mo-switch-text\"><span class=\"mo-switch-name\">Warnings</span><span class=\"mo-desc\">NWS outlines</span></span>\n            <input type=\"checkbox\" role=\"switch\" id=\"tg-warnings\" checked>\n          </label>\n        </div>\n        <div class=\"mo-switch\">\n          <label class=\"mo-switch-row\">\n            <span class=\"mo-switch-text\"><span class=\"mo-switch-name\">Storm reports</span><span class=\"mo-desc\">Storm Prediction Center (SPC), last 3 days</span></span>\n            <input type=\"checkbox\" role=\"switch\" id=\"tg-reports\" data-legend=\"No report is not “no hail”.\">\n          </label>\n          <p class=\"mo-line\" id=\"mo-reports-line\" hidden></p>\n        </div>\n      </div>\n      <section class=\"mo-reset\">\n        <button type=\"button\" class=\"mo-reset-btn\" id=\"mo-reset\">Reset</button>\n        <p class=\"mo-sub\">Back to Map and Precipitation, with Points of interest and Warnings on. Everything else off.</p>\n      </section>\n    </div>\n  </section>\n\n",
  1
 ],
