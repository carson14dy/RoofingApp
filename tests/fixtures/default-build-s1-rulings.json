  "        </div>\n        <section class=\"glass popover\" id=\"layers\" role=\"dialog\" aria-labelledby=\"layers-title\" hidden>\n          <h2 class=\"pop-title\" id=\"layers-title\">Map layers</h2>\n          <fieldset class=\"choices\">\n            <legend class=\"visually-hidden\">Weather layer</legend>\n            <label class=\"choice\"><input type=\"radio\" name=\"layer\" value=\"precip\"><span class=\"swatch sw-precip\" aria-hidden=\"true\"></span><span class=\"choice-text\">Precipitation</span></label>\n            <label class=\"choice\"><input type=\"radio\" name=\"layer\" value=\"temp\"><span class=\"swatch sw-temp\" aria-hidden=\"true\"></span><span class=\"choice-text\">Temperature</span></label>\n            <label class=\"choice\"><input type=\"radio\" name=\"layer\" value=\"wind\"><span class=\"swatch sw-wind\" aria-hidden=\"true\"></span><span class=\"choice-text\">Wind gusts</span></label>\n          </fieldset>\n          <fieldset class=\"choices base-choices\">\n            <legend>Base map</legend>\n            <label class=\"choice\"><input type=\"radio\" name=\"base\" value=\"map\" checked><span class=\"choice-text\">Map</span></label>\n            <label class=\"choice\"><input type=\"radio\" name=\"base\" value=\"imagery\"><span class=\"choice-text\">Imagery<small>Aerial imagery with roads and names from USGS. Your IP address and the map area you view go to USGS while it is on.</small></span></label>\n          </fieldset>\n          <div class=\"toggles\">\n            <label class=\"toggle\"><span class=\"toggle-text\">Warnings<small>NWS outlines</small></span><input type=\"checkbox\" role=\"switch\" id=\"tg-warnings\" checked></label>\n            <label class=\"toggle\"><span class=\"toggle-text\">Storm reports<small>SPC, last 3 days</small></span><input type=\"checkbox\" role=\"switch\" id=\"tg-reports\"></label>\n          </div>\n        </section>\n        <button type=\"button\" class=\"glass round icon-btn\" id=\"btn-list\" aria-label=\"List of alerts and towns\" aria-haspopup=\"dialog\">\n",
  "        </div>\n        <button type=\"button\" class=\"glass round icon-btn\" id=\"btn-list\" aria-label=\"List of alerts and towns\" aria-haspopup=\"dialog\">\n",
