    "impacts": [
      {
        "stage": 13,
        "statement": "Flooding to low lying areas adjacent to the river is likely. Flood prone areas include Target Range and the Orchard Homes neighborhoods."
      },
      {
        "stage": 11.5,
        "statement": "Numerous homes along the west end of Harpers Road are surrounded with surface water and ground water. Harpers Road adjacent to the Clark Fork River is flooded and impassable.  Flood waters are also threatening Malards Way."
      },
      {
        "stage": 11,
        "statement": "Flooding of low lying areas adjacent to the river is possible just west of Missoula to Frenchtown. "
      }
