    "impacts": [
      {
        "stage": 34.08,
        "statement": "This matches the level of the record June 2011 flood."
      },
      {
        "stage": 34,
        "statement": "Highway 24...Fort Peck Highway will begin to flood a quarter mile south of the Milk River Bridge."
      },
      {
        "stage": 33.75,
        "statement": "Highway 42 also known as Fort Peck Highway near Sullivan Park becomes completely submerged. Traffic barriers should be placed by law enforcement to restrict traffic."
      },
      {
        "stage": 33.2,
        "statement": "This matches the stage level of the 1952 flood."
      },
      {
        "stage": 33,
        "statement": "Fort Peck Highway...Montana 42...begins to flood near Sullivan Park. "
      },
      {
        "stage": 32.79,
        "statement": "Most roads in the lower Milk River Valley are flooded."
      },
      {
        "stage": 31,
        "statement": "Flooding will begin to affect buildings between the Fort Peck Highway and the Milk River east of Glasgow. Sullivan Park will be totally covered by flood waters."
      },
      {
        "stage": 30,
        "statement": "Storm drainage valves along Glasgow levee will back-flood into the southside of Glasgow if not closed. Flooding begins on Rahlf Lane off of Highway 24."
      },
      {
        "stage": 29.5,
        "statement": "Livestock/feedlots adjacent to Milk River become isolated by flood water. Livestock relocation to higher ground should have started."
      },
      {
        "stage": 29,
        "statement": "Water begins to flow over Whately Road...which is about 7 miles east of Glasgow. Baseball field at Sullivan Park flooded."
      },
      {
        "stage": 28,
        "statement": "Water begins to flow across 6th Ave SW also known as Aitken Road south of the Milk River Bridge.  "
      },
      {
        "stage": 26.75,
        "statement": "Back trail in Sullivan Park begins to flood."
      },
      {
        "stage": 26,
        "statement": "Some flooding will also occur on area farmlands."
      },
      {
        "stage": 25,
        "statement": "This is flood stage. Expect some low-land flooding to occur."
      }
    ]
  },
