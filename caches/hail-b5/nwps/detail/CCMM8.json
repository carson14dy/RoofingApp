    "impacts": [
      {
        "stage": 8,
        "statement": "At 8.0 feet, water is about 2 to 3 feet deep in corrals along Clear Creek. (April 8, 2023 and again on May 8, 2024)"
      },
      {
        "stage": 6.5,
        "statement": "Machinist Road not passable. Clear Creek Road covered by water in two locations."
      },
      {
        "stage": 6,
        "statement": "Spotter - Bears Paw: Ranch near Clear Creek starts to get impacted. Forced cattle out of corral. (March 2017)"
      },
      {
        "stage": 5.5,
        "statement": "Water starting to cover Machinist Road and Clear Creek Road."
      },
      {
        "stage": 3.7,
        "statement": "Water starting to push onto Clear Creek Road in some locations, including Lloyd...don't know how accurate this impact is...June 2017."
