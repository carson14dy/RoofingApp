    "impacts": [
      {
        "stage": 22,
        "statement": "Flooding in Columbia Falls, Kalispell, Creston and Foy's Bend causing isolation of many homes within the valley. Many secondary roads are impassable and closures of Highway 93 are expected."
      },
      {
        "stage": 18,
        "statement": "Flooding of low lying areas in Columbia Falls including many buildings and secondary roads. There is also possible flooding along Highway 93 between Kalispell and Sommers."
      },
      {
        "stage": 16.1,
        "statement": "A trailer and RV park located just north of Highway 35 in Evergreen may be flooded."
      },
      {
        "stage": 16,
        "statement": "Low lying buildings and roads in the vicinity of Kalispell, Creston, Columbia Falls and Foy's Bend begin flooding."
      },
      {
        "stage": 14,
        "statement": "Flooding of farmers crops adjacent to the Flathead River is likely. Sections of the Steel Bridge Road become inundated with water and impassable."
      },
      {
        "stage": 13,
        "statement": "Farmers crops adjacent to the Flathead River are inundated with water."
      }
    ]
