      {
        "stage": 13,
        "statement": "Bear Creek will begin to back up from the St Joe River and may start to spill into the town of Calder, flooding the low spots in yards, roads and parking lots. "
      },
      {
        "stage": 11,
        "statement": "Flooding in riverside RV areas near Meadow and Oxbow Lanes downstream of Calder to the Cutthroat Resort. "
      },
      {
        "stage": 10,
        "statement": "Water may cover the low spots on Calder Road between the St Joe River Road and the Calder Bridge."
      }
    ]
