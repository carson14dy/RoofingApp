      {
        "stage": 19,
        "statement": "Major Flood Stage. Water may begin to wash against the main highway bridge."
      },
      {
        "stage": 18,
        "statement": "Water covers the concrete bridge supports."
      },
      {
        "stage": 17,
        "statement": "Moderate Flood Stage. Some structural flooding is possible near the Little Missouri River."
      },
      {
        "stage": 16,
        "statement": "Water covers erosion control walls upstream from the highway bridge. Minor flooding along lower areas of west bank begins. "
      },
      {
        "stage": 14,
        "statement": "Water overflows tree-line along the east bank. Minor flooding of pasture land."
      },
      {
        "stage": 12,
        "statement": "Flood Stage. Water overflows areas along the east bank and causes lowland pasture flooding."
      }
    ]
