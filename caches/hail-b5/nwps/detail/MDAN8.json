    "impacts": [
      {
        "stage": 19,
        "statement": "Much of the town of Medora is susceptible to flooding. The steep bank on the left side is subject to overflow."
      },
      {
        "stage": 18,
        "statement": "Highway 10 begins to flood-town of Medora very flat and is subject to flooding."
      },
      {
        "stage": 17,
        "statement": "A few rural homes next to the river near Medora may be flooded."
      },
      {
        "stage": 15,
        "statement": "Right bank overflows and damages camping area on the west side of Medora."
      },
      {
        "stage": 13,
        "statement": "Water backs up into ditches along Highway 10. Cottonwood campground-5 mi into park has water out of banksin very low spots. Campground and Visitor Center unharmed.  "
      },
      {
        "stage": 12,
        "statement": "Low spots on right bank overflow."
      }
    ]
