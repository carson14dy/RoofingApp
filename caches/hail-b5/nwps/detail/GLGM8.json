    "impacts": [
      {
        "stage": 7.2,
        "statement": "Small bridge near gallatin gateway and a few homes west of town are beginning to flood."
      },
      {
        "stage": 7.1,
        "statement": "Water flows over road connecting two bridges over gallatin river. Three forest service campgrounds flood, including the one at squaw creek."
      },
      {
        "stage": 7,
        "statement": "Minor roads in gallatin gateway covered with water."
      },
      {
        "stage": 6.3,
        "statement": "Water flows over the axtell and irwin bridges."
      },
      {
        "stage": 6.1,
        "statement": "Flooding of the lowlands along the gallatin river."
      },
      {
        "stage": 6,
        "statement": "Water flows over roads as well as several smalller bridges. Several forest service campgrounds as well as some home west of town begin to flood."
      },
      {
        "stage": 5,
        "statement": "Gallatin river on west side of gallatin gateway can come out of banks at mill road near where the road crosses the river. Water may work into area yards and fields, and may encroach onto mill road."
      }
    ]
