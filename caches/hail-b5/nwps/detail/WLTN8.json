    "impacts": [
      {
        "stage": 33,
        "statement": "Levees surrounding Williston are likely to be topped without additional measures taken to temporarily raise the flood protection levels."
      },
      {
        "stage": 32.5,
        "statement": "Missouri River begins to overtop small stretch of levee near Highway 85 bridge and Williston Water Treatment Plant."
      },
      {
        "stage": 30.75,
        "statement": "Missouri River begins to cover Highway 85 south of Williston."
      },
      {
        "stage": 30.5,
        "statement": "At 30.5 FT...water is near the top of Highway 58 in areas between Fairview and Trenton."
      },
      {
        "stage": 30,
        "statement": "Water covers portions of 13th Avenue East and 11th Avenue East along the Little Muddy River."
      },
      {
        "stage": 28,
        "statement": "Water backing up into the Little Muddy River begins to cover 54th Street Northwest on the east side of Williston."
      },
      {
        "stage": 24,
        "statement": "Water begins to cover oil well location south and east of Williston. Wildlife management areas are flooded. City of Williston does not flood."
      },
      {
        "stage": 22,
        "statement": "Low-lying farmland and access roads to oil well sites near Trenton are flooded. City of Williston does not flood."
      },
      {
        "stage": 20,
        "statement": "Ditches in the vicinity of the river will fill and wildlife management lands along the south banks will begin to flood.  "
      }
    ]
