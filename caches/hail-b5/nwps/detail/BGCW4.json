    "impacts": [
      {
        "stage": 5.5,
        "statement": "Flooding of low lying property becomes more widespread along the right bank upstream and downstream of gage. Water begins to encroach low lying areas west of the highway bridge adjacent to gage. Flooding downstream in sheridan at leopard street and at nb avenue intensifiies and becomes more widespread. Flood wave travel time from gage to sheridan is 4 to 6 hours."
      },
      {
        "stage": 5,
        "statement": "Flood stage. Minor flooding of low lying property along right bank upstream and downstream of gage. Water level up to beaver creek road and owl creek road near the gauge and on leopard street in sheridan. Any higher and road closures will be needed and access to some homes is cut off. Flood wave travel time from gage to sheridan is 4 to 6 hours."
      },
      {
        "stage": 4.5,
        "statement": "Bankfull stage. Water begins to encroach low lying areas along right bank upstream and downstream from gage. DES indicating low land flooding in the Sheridan vicinity begins around this stage. "
      }
    ]
