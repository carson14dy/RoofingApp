    "impacts": [
      {
        "stage": 3.9,
        "statement": "At 3.9 Feet, water is well out of its bank north of York Road. Most flooding in the ag fields next too the creek. From a combination of rain/snow melt."
      },
      {
        "stage": 3.5,
        "statement": "At 3.5 feet, the creek is out of its banks around the York Road crossing. Combination of rain and high snow melt from the Elkhorns. June 2023."
      },
      {
        "stage": 2.8,
        "statement": "At 2.8 feet the creek starts to come out of its bank near the York Road bridge crossing, just north of Chadwick Nursery. Starts flooding ag land in that region. All from snow melt."
      }
    ]
  },
