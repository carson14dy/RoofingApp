    "impacts": [
      {
        "stage": 10,
        "statement": "Major flood stage. Extensive flooding along Bear Butte Creek with inundation of structures and roads in Boulder Canyon and Sturgis."
      },
      {
        "stage": 8,
        "statement": "Moderate flood stage. Some inundation of structures and roads along Bear Butte Creek in Boulder Canyon and Sturgis."
      },
      {
        "stage": 6.5,
        "statement": "Flood stage. Flooding affects secondary roads near Sturgis. The low water crossing a quarter mile upstream from the gage floods and access to homes is cutoff. "
      },
      {
        "stage": 5.7,
        "statement": "Access roads off of Boulder Canyon Road can become impassable."
      },
      {
        "stage": 5.5,
        "statement": "Action stage. Flooding of low lying areas along the creek."
      },
      {
