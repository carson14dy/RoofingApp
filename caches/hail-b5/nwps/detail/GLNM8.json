    "impacts": [
      {
        "stage": 67,
        "statement": "Much of downtown Glendive will be flooded."
      },
      {
        "stage": 66,
        "statement": "This is the flood of record due to ice jam."
      },
      {
        "stage": 65,
        "statement": "West Glendive levee will be overtopped flooding most of West Glendive. Interstate 94 will flood at milepost 214 between the Montana 16 exit and the Yellowstone River. "
      },
      {
        "stage": 60.5,
        "statement": "Marsh Road on the south end of Glendive will flood. Riverview Trailer Park will start to flood.    "
      },
      {
        "stage": 54,
        "statement": "Toepke Park on the east side of the river begins to flood."
      },
      {
        "stage": 53.65,
        "statement": "Minor flooding begins at 53.65 feet in a reach 5 miles above and below Glendive."
      },
      {
        "stage": 53.5,
        "statement": "This is flood stage.  "
      },
      {
        "stage": 51.5,
        "statement": "Low-land flooding will affect some ranches along the Yellowstone River."
