    "impacts": [
      {
        "stage": 13,
        "statement": "Wide spread flooding from East Missoula to the Bitterroot River is possible. Flood prone areas include, Streets and homes in the lower South Third Street area. Extensive flooding in the Orchard Homes area continues."
      },
      {
        "stage": 12,
        "statement": "Flood waters are now flooding numerous streets and homes in the Orchard Homes area. The following streets are being flooded, Kehrwald Drive, Channel Drive, Tower Street, Nancy Lou Drive, Keck Street and Stone Street. Flood water may also flood the southern end of Schmidt Road which is adjacent to the Clark Fork River."
      },
      {
        "stage": 11,
        "statement": "Flooding from the Clark Fork River is impacting the Orchard Homes residential area. Flood waters are now flooding Tower Street, Kehrwald Drive and Channel Drive with 10 to 15 homes being flooded."
      },
      {
        "stage": 8,
        "statement": "Flooding of low lying areas adjacent to the river is possible. Flood waters begin to flood streets in the Orchard Homes area, specifically the north end of Tower Street including Kehrwald Drive."
      },
      {
        "stage": 7.5,
        "statement": "Flooding of low lying areas adjacent to the river is possible. Flood waters begin to flood streets in the Orchard Homes area, specifically the north end of Tower Street including Kehrwald Drive."
      }
    ]
