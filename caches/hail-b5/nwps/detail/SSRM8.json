    "impacts": [
      {
        "stage": 12,
        "statement": "Major flooding. More than 100,000 acres flood."
      },
      {
        "stage": 10.8,
        "statement": "At 10.8 Feet - June 20 2018 - Flooding in the city of Sun River similar to 2011. Most streets under water. Photos estimate water 2 to 4 feet deep. Highway 200 Closed from the 89 Junction all the way to the 287 Junction. Roger's Pass had a culvert washout which closed that section."
      },
      {
        "stage": 10.7,
        "statement": "June 2018 - 1st and 2nd street flood in Sun River. Gravel washed away roadway, exposing optic cables. In Fort Shaw - North Fort Shaw Road completely destroyed. Culverts under roadway were exposed."
      },
      {
        "stage": 9.1,
        "statement": "May 27, 2019 - At 9.1 feet - Streets and homes in Sun River flooded. Not as bad as the 2018 flood. Highway 200 had water over the highway, with flaggers. Water around homes. Fields did flood."
      },
      {
        "stage": 9,
        "statement": "Much of the valley is flooded. Highway 200 flooded. Many homes as well as agricultural land floods."
      },
      {
        "stage": 8.5,
        "statement": "Hwy 200 through town of Sun River, between 1st St and 3rd St, under water. Significant inundation of town between river to W, N, and E of town to beyond W Carroll St/Steell St. Sun River-Cascade Rd inundated for approx 1/3 mile to south of town."
      },
      {
        "stage": 8,
        "statement": "Water starting to cover Hwy 200 between 1st St and 2nd ST. River well out of banks W, N and E of town and filling old oxbows near town and Hwy 200."
      },
      {
        "stage": 7.5,
        "statement": "River out of banks and across highway at Sun River (town). Water over Fairfield Road. River within banks at Simms and Fort Shaw. About two dozen homes in Sun River (town) become isolated."
      },
      {
        "stage": 7,
        "statement": "Minor overflow between Fort Shaw and Sun River (town) where the river meanders and gets into the old river bed."
      },
      {
        "stage": 6.5,
        "statement": "Some overflow between Fort Shaw and Sun Siver (town) where the river meanders and gets into the old river bed."
      },
      {
        "stage": 6,
        "statement": "River is bankfull."
      }
    ]
  },
